{
  "name": "airscope-indonesia",
  "version": "0.1.0",
  "private": true,
  "description": "Hybrid IoT and satellite air quality monitoring platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --no-error-on-unmatched-pattern --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,json}\" \"*.{json,yaml,yml,md}\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,json}\" \"*.{json,yaml,yml,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@12.9.1"
}
