generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AlertEvent {
  id                 String    @id
  fingerprint        String    @unique
  conditionKey       String?
  episodeNumber      Int       @default(1)
  sensorCode         String
  type               String
  severity           String
  status             String    @default("ACTIVE")
  title              String
  detail             String
  occurredAt         DateTime
  lastObservedAt     DateTime?
  clearedAt          DateTime?
  acknowledgedAt     DateTime?
  acknowledgedBy     String?
  acknowledgmentNote String?
  resolvedAt         DateTime?
  resolvedBy         String?
  resolutionNote     String?
  source             String    @default("DERIVED_SIMULATION")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([conditionKey, episodeNumber])
  @@index([conditionKey, status])
  @@index([sensorCode, occurredAt])
  @@index([status, severity])
  @@index([type, status])
}
